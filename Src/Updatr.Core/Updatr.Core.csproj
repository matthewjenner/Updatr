<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic. No UI, no WinRT, no P/Invoke, no file paths. See CLAUDE.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The built-in catalog: the last-resort origin when neither GitHub nor the cache on the drive
      has a usable copy. Read by EmbeddedCatalogOrigin.
    -->
    <EmbeddedResource Include="..\..\catalog\*.json" LogicalName="Updatr.Catalog.%(Filename)%(Extension)" Link="Catalog\Embedded\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
