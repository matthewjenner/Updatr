<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows implementations of the Core abstractions, shared by the GUI and the CLI. -->
  <PropertyGroup>
    <TargetFramework>$(UpdatrWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(UpdatrMinWindows)</SupportedOSPlatformVersion>
    <!-- Required by the [LibraryImport] source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The interop package copies its native activation factory per architecture and errors on
      AnyCPU. A library has no architecture; the App and Cli executables reference the package
      directly so the right native DLL lands next to them.
    -->
    <MicrosoftManagementDeployment-ErrorNoPlatform>false</MicrosoftManagementDeployment-ErrorNoPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- GeneratePathProperty exposes $(PkgMicrosoft_WindowsPackageManager_ComInterop) for the embed below. -->
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Spare copy of the WinGet metadata. It must sit beside the exe (Directory.Build.targets); if a
      user copies only the exes to a drive, WinGetRuntime writes this back on startup.
    -->
    <EmbeddedResource Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)\lib\uap10.0\Microsoft.Management.Deployment.winmd"
                      LogicalName="Updatr.WinGet.Microsoft.Management.Deployment.winmd" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Updatr.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Updatr.Core\Updatr.Core.csproj" />
  </ItemGroup>
</Project>
