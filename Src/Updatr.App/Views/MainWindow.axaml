<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Updatr.App.ViewModels"
        xmlns:conv="using:Updatr.App.Converters"
        xmlns:views="using:Updatr.App.Views"
        x:Class="Updatr.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://Updatr/Assets/icon.ico"
        Width="1320" Height="800" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <!-- One template per page ViewModel. -->
        <DataTemplate DataType="vm:AppsPageViewModel">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="vm:InstallPageViewModel">
            <views:InstallView />
        </DataTemplate>
        <DataTemplate DataType="vm:DebloatPageViewModel">
            <views:DebloatView />
        </DataTemplate>

        <DataTemplate DataType="vm:PlaceholderPageViewModel">
            <StackPanel Margin="32" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" />
                <TextBlock Text="{Binding Arrives, StringFormat='Arrives in {0}.'}" Opacity="0.55" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:LogPageViewModel">
            <DockPanel Margin="24">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Clear view" Command="{Binding ClearCommand}" />
                    <TextBlock Text="Log" FontSize="24" FontWeight="SemiBold" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Entries}" FontFamily="Consolas,Courier New,monospace" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogRowViewModel">
                            <Grid ColumnDefinitions="96,76,92,*" ToolTip.Tip="{Binding Text}">
                                <TextBlock Text="{Binding Time}" Opacity="0.6" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Margin="0,0,10,0" Padding="0,1" CornerRadius="3" BorderThickness="1"
                                        BorderBrush="{Binding Tone, Converter={x:Static conv:CheckStateBrushConverter.Instance}}">
                                    <TextBlock Text="{Binding Level}" HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{Binding Tone, Converter={x:Static conv:CheckStateBrushConverter.Instance}}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" Opacity="0.75" VerticalAlignment="Center" />
                                <SelectableTextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:SettingsPageViewModel">
            <ScrollViewer>
                <StackPanel Margin="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Data folder" FontWeight="SemiBold" />
                        <SelectableTextBlock Text="{Binding DataFolder}" Opacity="0.85" />
                        <TextBlock Text="Carts, templates, settings, and logs live here and travel with the drive." FontSize="12" Opacity="0.6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="This run's log" FontWeight="SemiBold" />
                        <SelectableTextBlock Text="{Binding LogFile}" Opacity="0.85" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Check for an update" Command="{Binding SelfUpdateCommand}" />
                            <TextBlock Text="{Binding UpdateResult}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Checking while Updatr is open" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="260,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Text="New Updatr version and catalog" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding UpdatrIntervals}" SelectedItem="{Binding UpdatrInterval}" MinWidth="220" />
                            <TextBlock Grid.Row="1" Text="Updates for installed apps" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AppIntervals}" SelectedItem="{Binding AppInterval}" MinWidth="220" />
                        </Grid>
                        <TextBlock Text="Nothing is installed by a check; news shows as a banner and as a count beside Apps. The app check lists quietly, one winget query at a time, and waits while you are working on the Apps page - any refresh or run resets its clock."
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SettingsResult}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                   IsVisible="{Binding SettingsResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="App catalog" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CatalogDescription}" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Administrator access" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Test administrator access" Command="{Binding TestAdminCommand}" />
                            <TextBlock Text="{Binding AdminTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                        <TextBlock Text="Shows one UAC prompt and checks the elevated helper that machine-wide installs and debloat use."
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Run checks again" Command="{Binding RerunChecksCommand}"
                                    IsEnabled="{Binding !Preflight.IsRunning}" />
                            <TextBlock Text="Machine checks" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Preflight.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckRowViewModel">
                                    <Grid ColumnDefinitions="48,180,*" Margin="0,4">
                                        <TextBlock Text="{Binding State, Converter={x:Static conv:CheckStateTagConverter.Instance}}"
                                                   Foreground="{Binding State, Converter={x:Static conv:CheckStateBrushConverter.Instance}}"
                                                   FontWeight="SemiBold" FontFamily="Consolas,Courier New,monospace" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />
                                            <SelectableTextBlock Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                 TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                                            <Button Content="{Binding Fix.Label, FallbackValue=''}" Command="{Binding RunFixCommand}"
                                                    IsVisible="{Binding HasFix}" Classes="accent" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- Banner strip: app-level state from preflight and the data folder. -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Banners}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BannerViewModel">
                    <Border Padding="16,8" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding Severity, Converter={x:Static conv:CheckStateBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Content="Dismiss" Padding="8,1" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding CanDismiss}"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissBannerCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Navigation. -->
        <Border DockPanel.Dock="Left" Width="190" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,16,16,12">
                    <Image Source="avares://Updatr/Assets/icon.png" Width="28" Height="28" />
                    <TextBlock Text="Updatr" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <TextBlock Text="{Binding Page.NavTitle}" Margin="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
