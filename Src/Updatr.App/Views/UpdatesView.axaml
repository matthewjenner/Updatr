<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Updatr.App.ViewModels"
             xmlns:conv="using:Updatr.App.Converters"
             xmlns:b="using:Updatr.App.Behaviors"
             x:Class="Updatr.App.Views.UpdatesView"
             x:DataType="vm:UpdatesPageViewModel">
    <DockPanel Margin="20,16">
        <!-- Header: title, counts, filters. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding SourceFilter}" Width="150" />
                <TextBox PlaceholderText="Search name or id" Text="{Binding SearchText}" Width="240" />
                <ToggleSwitch OnContent="Updates only" OffContent="Everything installed" IsChecked="{Binding ShowUpdatesOnly}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Updates" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Counts}" Opacity="0.6" />
            </StackPanel>
        </DockPanel>

        <!-- Actions. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
            <Button Content="Upgrade all" Command="{Binding UpgradeAllCommand}" Classes="accent" Margin="0,0,8,6"
                    ToolTip.Tip="Everything with an update, except held, self-updating, Store-managed, and launcher-managed apps." />
            <Button Content="Upgrade selected" Command="{Binding UpgradeCheckedCommand}" Margin="0,0,8,6" />
            <Button Content="Reinstall selected" Command="{Binding ReinstallCheckedCommand}" Margin="0,0,8,6" />
            <Button Content="Hold selected" Command="{Binding HoldCheckedCommand}" Margin="0,0,8,6" />
            <Button Content="Release selected" Command="{Binding UnholdCheckedCommand}" Margin="0,0,8,6" />
            <Button Content="Select all updates" Command="{Binding CheckUpdatesCommand}" Margin="16,0,8,6" />
            <Button Content="Clear selection" Command="{Binding ClearChecksCommand}" Margin="0,0,8,6" />
        </WrapPanel>

        <!-- Status line: what is running, with a cancel. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsVisible="{Binding IsBusy}">
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="10,0,0,0" />
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Minimum="0" Maximum="1" Height="4"
                             Value="{Binding BusyFraction, FallbackValue=0}"
                             IsIndeterminate="{Binding BusyFraction, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>
        </DockPanel>

        <DataGrid ItemsSource="{Binding View}" b:RowSelection.Enabled="True" IsReadOnly="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                  CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Id" Binding="{Binding Id}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Installed" Binding="{Binding Installed}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Available" Binding="{Binding Available}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Source" Binding="{Binding Catalog}" Width="*" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Status" Width="1.4*" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PackageRowViewModel">
                            <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding StatusDetail}" VerticalAlignment="Center" Margin="8,0"
                                       Foreground="{Binding Kind, Converter={x:Static conv:RowStatusBrushConverter.Instance}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Activity" Width="2*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PackageRowViewModel">
                            <StackPanel VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="{Binding Activity}">
                                <TextBlock Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Kind, Converter={x:Static conv:RowStatusBrushConverter.Instance}}" />
                                <ProgressBar Minimum="0" Maximum="1" Height="3" Value="{Binding Progress, FallbackValue=0}"
                                             IsVisible="{Binding Progress, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
