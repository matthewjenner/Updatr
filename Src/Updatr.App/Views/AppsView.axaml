<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Updatr.App.ViewModels"
             xmlns:conv="using:Updatr.App.Converters"
             xmlns:b="using:Updatr.App.Behaviors"
             xmlns:views="using:Updatr.App.Views"
             x:Class="Updatr.App.Views.AppsView"
             x:DataType="vm:AppsPageViewModel">
    <DockPanel Margin="20,16">
        <TextBlock DockPanel.Dock="Top" Text="Apps" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />

        <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
            <!-- Installed apps: one list, one selection, every action. -->
            <TabItem Header="Installed apps">
                <DockPanel>
                    <!-- Counts and search. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox DockPanel.Dock="Right" PlaceholderText="Search name, id, or publisher" Text="{Binding SearchText}" Width="280" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Counts}" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- Filters: any number of chips per group; groups combine. Clear Status to see every app. -->
                    <views:FilterBarView DockPanel.Dock="Top" DataContext="{Binding Filters}" Margin="0,0,0,6" />

                    <!-- Actions: updates, then the selection, then removal kept apart. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
                        <Button Content="{Binding UpgradeAllText}" Command="{Binding UpgradeAllCommand}" Classes="accent" Margin="0,0,8,6"
                                ToolTip.Tip="Every update on screen (filters and search apply), except held, self-updating, Store-managed, and launcher-managed apps." />
                        <Button Content="Upgrade selected" Command="{Binding UpgradeCheckedCommand}" Margin="0,0,8,6" />
                        <Button Content="Reinstall selected" Command="{Binding ReinstallCheckedCommand}" Margin="0,0,8,6" />
                        <Button Content="Hold selected" Command="{Binding HoldCheckedCommand}" Margin="0,0,8,6" />
                        <Button Content="Release selected" Command="{Binding UnholdCheckedCommand}" Margin="0,0,8,6" />
                        <Button Content="{Binding UninstallText}" Command="{Binding UninstallCheckedCommand}" Margin="16,0,8,6"
                                ToolTip.Tip="Runs each app's own uninstaller, one at a time; afterwards Updatr looks for what it left behind (see Leftovers)." />
                        <Button Content="Select all updates" Command="{Binding CheckUpdatesCommand}" Margin="16,0,8,6" />
                        <Button Content="Clear selection" Command="{Binding ClearChecksCommand}" Margin="0,0,8,6" />
                    </WrapPanel>

                    <!-- Status line: what is running, with a cancel. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsVisible="{Binding IsBusy}">
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="10,0,0,0" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Minimum="0" Maximum="1" Height="4"
                                         Value="{Binding BusyFraction, FallbackValue=0}"
                                         IsIndeterminate="{Binding BusyFraction, Converter={x:Static ObjectConverters.IsNull}}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding View}" b:RowSelection.Enabled="True" IsReadOnly="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                              CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Publisher" Binding="{Binding Publisher}" Width="1.3*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Id" Binding="{Binding Id}" Width="1.6*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Installed" Binding="{Binding Installed}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Available" Binding="{Binding Available}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Source" Binding="{Binding Catalog}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Kind" Binding="{Binding KindLabel}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Status" Width="1.4*" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PackageRowViewModel">
                                        <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding StatusDetail}" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{Binding Kind, Converter={x:Static conv:RowStatusBrushConverter.Instance}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Activity" Width="2*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PackageRowViewModel">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="{Binding Activity}">
                                            <TextBlock Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Kind, Converter={x:Static conv:RowStatusBrushConverter.Instance}}" />
                                            <ProgressBar Minimum="0" Maximum="1" Height="3" Value="{Binding Progress, FallbackValue=0}"
                                                         IsVisible="{Binding Progress, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Leftovers: review per app (nothing pre-selected); quarantine on the right. -->
            <TabItem Header="Leftovers">
                <Grid ColumnDefinitions="*,320" DataContext="{Binding Leftovers}" x:DataType="vm:LeftoversViewModel">
                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding QuarantineText}" Command="{Binding QuarantineSelectedCommand}" Classes="accent" />
                                <Button Content="Select high confidence" Command="{Binding SelectHighCommand}" />
                                <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Click what to clean up - nothing is selected for you. Picked items move into quarantine on the drive (files zipped, keys and settings saved) and can be restored until purged." />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Scans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeftoverScanViewModel">
                                        <StackPanel Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissCommand}" Padding="8,2"
                                                        ToolTip.Tip="Stop listing these; nothing on the PC is touched" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LeftoverRowViewModel">
                                                        <Border Classes="pick" Classes.selected="{Binding IsSelected}" b:RowSelection.ToggleOnClick="True">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Classes="tag" Text="{Binding ConfidenceText}"
                                                                           Foreground="{Binding Tone, Converter={x:Static conv:CheckStateBrushConverter.Instance}}" />
                                                                <StackPanel Spacing="1">
                                                                    <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="16,0,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,4,0,8">
                                <TextBlock Text="Quarantine" FontWeight="SemiBold" />
                                <TextBlock Text="On the drive, for this PC. Restore puts everything back; purge deletes it for good."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Quarantine}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuarantineRowViewModel">
                                            <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Restore" Command="{Binding RestoreCommand}" Padding="8,2" />
                                                        <Button Content="Purge" Command="{Binding PurgeCommand}" Padding="8,2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
