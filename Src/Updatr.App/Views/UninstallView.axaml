<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Updatr.App.ViewModels"
             xmlns:conv="using:Updatr.App.Converters"
             xmlns:b="using:Updatr.App.Behaviors"
             x:Class="Updatr.App.Views.UninstallView"
             x:DataType="vm:UninstallPageViewModel">
    <DockPanel Margin="20,16">
        <TextBlock DockPanel.Dock="Top" Text="Uninstall" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />

        <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
            <!-- Installed apps: pick rows, run their uninstallers. -->
            <TabItem Header="Installed apps">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox DockPanel.Dock="Right" PlaceholderText="Search name, id, or publisher" Text="{Binding SearchText}" Width="280" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="{Binding UninstallText}" Command="{Binding UninstallCheckedCommand}" Classes="accent" />
                            <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            <TextBlock Text="{Binding Counts}" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="Click rows to select them. Each app's own uninstaller runs, one at a time; afterwards Updatr looks for what it left behind (see Leftovers)." />

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsVisible="{Binding BusyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="10,0,0,0" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding View}" b:RowSelection.Enabled="True" IsReadOnly="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Publisher" Binding="{Binding Publisher}" Width="1.3*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Version" Binding="{Binding Installed}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Source" Binding="{Binding Catalog}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:PackageRowViewModel" Header="Id" Binding="{Binding Id}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Activity" Width="2*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PackageRowViewModel">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="{Binding Activity}">
                                            <TextBlock Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Kind, Converter={x:Static conv:RowStatusBrushConverter.Instance}}" />
                                            <ProgressBar Minimum="0" Maximum="1" Height="3" Value="{Binding Progress, FallbackValue=0}"
                                                         IsVisible="{Binding Progress, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Leftovers: review per app (nothing pre-selected); quarantine on the right. -->
            <TabItem Header="Leftovers">
                <Grid ColumnDefinitions="*,320" DataContext="{Binding Leftovers}" x:DataType="vm:LeftoversViewModel">
                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding QuarantineText}" Command="{Binding QuarantineSelectedCommand}" Classes="accent" />
                                <Button Content="Select high confidence" Command="{Binding SelectHighCommand}" />
                                <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Click what to clean up - nothing is selected for you. Picked items move into quarantine on the drive (files zipped, keys and settings saved) and can be restored until purged." />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Scans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeftoverScanViewModel">
                                        <StackPanel Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissCommand}" Padding="8,2"
                                                        ToolTip.Tip="Stop listing these; nothing on the PC is touched" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LeftoverRowViewModel">
                                                        <Border Classes="pick" Classes.selected="{Binding IsSelected}" b:RowSelection.ToggleOnClick="True">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Classes="tag" Text="{Binding ConfidenceText}"
                                                                           Foreground="{Binding Tone, Converter={x:Static conv:CheckStateBrushConverter.Instance}}" />
                                                                <StackPanel Spacing="1">
                                                                    <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="16,0,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,4,0,8">
                                <TextBlock Text="Quarantine" FontWeight="SemiBold" />
                                <TextBlock Text="On the drive, for this PC. Restore puts everything back; purge deletes it for good."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Quarantine}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuarantineRowViewModel">
                                            <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Restore" Command="{Binding RestoreCommand}" Padding="8,2" />
                                                        <Button Content="Purge" Command="{Binding PurgeCommand}" Padding="8,2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
