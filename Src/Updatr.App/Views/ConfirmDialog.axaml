<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Updatr.App.Views.ConfirmDialog"
        Title="Updatr"
        Icon="avares://Updatr/Assets/icon.ico"
        Width="860" Height="560" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="No" Click="OnNo" />
            <Button Content="Yes" Click="OnYes" Classes="accent" IsDefault="True" />
        </StackPanel>
        <SelectableTextBlock x:Name="NoteText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.8" Margin="0,12,0,0" IsVisible="False" />
        <!-- One fill child: a DockPanel docks every child but the last, which would size the grid to its content. -->
        <Panel>
            <Border x:Name="ItemsBox" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" IsVisible="False">
                <DockPanel Grid.IsSharedSizeScope="True">
                    <Border x:Name="HeaderRow" DockPanel.Dock="Top" Padding="10,6"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                    <ScrollViewer>
                        <ItemsControl x:Name="Rows" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="DetailScroll">
                <SelectableTextBlock x:Name="DetailText" FontFamily="Consolas,Courier New,monospace" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
