<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Updatr.App.Views.ConfirmDialog"
        Title="Updatr"
        Icon="avares://Updatr/Assets/icon.ico"
        Width="560" Height="420" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="No" Click="OnNo" />
            <Button Content="Yes" Click="OnYes" Classes="accent" IsDefault="True" />
        </StackPanel>
        <ScrollViewer>
            <SelectableTextBlock x:Name="DetailText" FontFamily="Consolas,Courier New,monospace" FontSize="12" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</Window>
